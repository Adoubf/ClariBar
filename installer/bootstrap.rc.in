#include <windows.h>
1 RT_MANIFEST "@BOOTSTRAP_MANIFEST@"
1 ICON "@BRAND_ICON@"
101 RCDATA "@INNER_SETUP@"
1 VERSIONINFO
 FILEVERSION @APP_NUMERIC_VERSION@
 PRODUCTVERSION @APP_NUMERIC_VERSION@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Haoyue\0"
   VALUE "FileDescription", "ClariBar Setup\0"
   VALUE "FileVersion", "@APP_FILE_VERSION@\0"
   VALUE "ProductName", "ClariBar\0"
   VALUE "ProductVersion", "@APP_DISPLAY_VERSION@\0"
   VALUE "OriginalFilename", "ClariBar-Setup-@APP_DISPLAY_VERSION@-x64.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
