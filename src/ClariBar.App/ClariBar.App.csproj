<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>$(BaseIntermediateOutputPath)ClariBar.app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\ClariBar.ico</ApplicationIcon>
    <AssemblyName>ClariBar</AssemblyName>
    <Authors>Haoyue</Authors>
    <Company>Haoyue</Company>
    <Copyright>Copyright (c) 2026 Haoyue</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Adoubf/ClariBar</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Translation\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\branding\claribar-256.png" Link="Assets\ClariBar.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\branding\ClariBar.ico" Link="ClariBar.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\ClariBar.Core\ClariBar.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>
  <Target Name="GenerateApplicationIdentity" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(ApplicationManifest)"
      Lines="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest').Replace('@CLARIBAR_FILE_VERSION@', '$(FileVersion)'))"
      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
  <!-- The current WinUI SDK copies generated XAML/PRI to TargetDir but omits
       them from dotnet publish for an unpackaged, self-contained application. -->
  <Target Name="PublishApplicationXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <ApplicationXamlResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(ApplicationXamlResource)" DestinationFiles="@(ApplicationXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
