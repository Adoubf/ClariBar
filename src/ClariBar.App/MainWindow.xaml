<Window x:Class="ClariBar.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="Root" Background="{ThemeResource ClariBarToolbarBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="ShellTitleBar" IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBar_PaneToggleRequested" Background="{ThemeResource ClariBarToolbarBrush}">
   <TitleBar.Resources><HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment></TitleBar.Resources>
   <TitleBar.LeftHeader>
    <Button x:Name="HelpButton" Content="帮助" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="帮助" ToolTipService.ToolTip="帮助与快捷键 (F1)">
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="使用帮助" Click="Help_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Help"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem Text="键盘快捷键" Click="Shortcuts_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem Text="关于澄栏" Click="About_Click"/>
     </MenuFlyout></Button.Flyout>
    </Button>
   </TitleBar.LeftHeader>
   <TitleBar.Content>
    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="查找传感器" QueryIcon="Find" MaxWidth="460" MinWidth="120" Margin="24,0,24,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" QuerySubmitted="Search_Submitted" AutomationProperties.Name="查找传感器"/>
   </TitleBar.Content>
  </TitleBar>
  <Border x:Name="BodySurface" Grid.Row="1" Margin="8,0,8,8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
  <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="232" CompactPaneLength="56" Background="Transparent"
     IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
     SelectionChanged="Nav_SelectionChanged" AlwaysShowHeader="False">
   <NavigationView.Resources>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
   </NavigationView.Resources>
   <NavigationView.PaneHeader>
    <StackPanel x:Name="PaneIntro" Margin="16,22,12,24" Orientation="Horizontal" Spacing="10">
     <Image Source="Assets/ClariBar.png" Width="32" Height="32" AutomationProperties.Name="澄栏图标"/>
     <TextBlock Text="澄栏 ClariBar" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="概览" Tag="overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="任务栏外观" Tag="taskbar"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="资源监控" Tag="sensors"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="文字与图标" Tag="colors"><NavigationViewItem.Icon><SymbolIcon Symbol="FontColor"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="通用设置" Tag="general"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="关于" Tag="about"><NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel x:Name="PaneFooterContent" Margin="16,12,8,20" Spacing="12">
     <StackPanel x:Name="PaneMotto" Spacing="4">
      <TextBlock Text="你的任务栏，你的节奏" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock Text="外观与系统状态，尽在一处" Style="{StaticResource SecondaryText}"/>
     </StackPanel>
     <TextBlock x:Name="FooterVersion" Text="版本 0.6.1" Style="{StaticResource SecondaryText}" ToolTipService.ToolTip="澄栏 ClariBar 0.6.1"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <Border x:Name="PageSurface" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" Margin="0,8,8,8">
   <ScrollViewer x:Name="PageScroll" IsTabStop="True" Padding="28,22,28,32" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="PageContent" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch"/>
   </ScrollViewer>
   </Border>
  </NavigationView>
  </Border>
 </Grid>
</Window>
