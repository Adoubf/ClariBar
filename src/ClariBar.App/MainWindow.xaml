<Window x:Class="ClariBar.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" Background="{ThemeResource ClariBarToolbarBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="ShellTitleBar" IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBar_PaneToggleRequested" Background="{ThemeResource ClariBarToolbarBrush}">
   <TitleBar.Resources><HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment></TitleBar.Resources>
   <TitleBar.LeftHeader>
    <Button x:Name="HelpButton" Content="Help" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="Help" ToolTipService.ToolTip="Help and shortcuts (F1)">
     <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft">
      <MenuFlyoutItem x:Name="HelpMenuItem" Text="Help" Click="Help_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Help"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem x:Name="ShortcutsMenuItem" Text="Keyboard shortcuts" Click="Shortcuts_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="AboutMenuItem" Text="About ClariBar" Click="About_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
     </MenuFlyout></Button.Flyout>
    </Button>
   </TitleBar.LeftHeader>
   <TitleBar.Content>
    <Grid x:Name="TitleSearchHost">
     <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Find sensors" QueryIcon="Find" MaxWidth="460" MinWidth="120" Width="460" HorizontalAlignment="Left" VerticalAlignment="Center" QuerySubmitted="Search_Submitted" AutomationProperties.Name="Find sensors"/>
    </Grid>
   </TitleBar.Content>
  </TitleBar>
  <Border x:Name="BodySurface" Grid.Row="1" Margin="8,0,8,8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
  <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="232" CompactPaneLength="56" Background="Transparent"
     IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
     SelectionChanged="Nav_SelectionChanged" AlwaysShowHeader="False">
   <NavigationView.Resources>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
   </NavigationView.Resources>
   <NavigationView.PaneHeader>
    <StackPanel x:Name="PaneIntro" Margin="16,22,12,24" Orientation="Horizontal" Spacing="10">
     <Image x:Name="PaneIcon" Source="Assets/ClariBar.png" Width="32" Height="32" AutomationProperties.Name="ClariBar icon"/>
     <TextBlock x:Name="PaneTitle" Text="ClariBar" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Overview" Tag="overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Taskbar" Tag="taskbar"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Resource monitor" Tag="sensors"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Text &amp; icons" Tag="colors"><NavigationViewItem.Icon><SymbolIcon Symbol="FontColor"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Desktop tools" Tag="tools"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="General" Tag="general"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="About" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel x:Name="PaneFooterContent" Margin="16,12,8,20" Spacing="12">
     <StackPanel x:Name="PaneMotto" Spacing="4">
      <TextBlock x:Name="MottoTitle" Text="Your taskbar, your rhythm" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock x:Name="MottoSubtitle" Text="Style and system status, together" Style="{StaticResource SecondaryText}"/>
     </StackPanel>
     <TextBlock x:Name="FooterVersion" Text="ClariBar" Style="{StaticResource SecondaryText}" ToolTipService.ToolTip="ClariBar"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <Border x:Name="PageSurface" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" Margin="0,8,8,8">
   <ScrollViewer x:Name="PageScroll" IsTabStop="True" Padding="28,22,28,32" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="PageContent" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch"/>
   </ScrollViewer>
   </Border>
  </NavigationView>
  </Border>
 </Grid>
</Window>
